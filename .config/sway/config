### Variables
set $mod Mod4
set $term wezterm
set $menu rofi -show drun

# Colors 
set $norm_fg
set $norm_bg
set $norm_border 
set $sel_fg
set $sel_bg
set $sel_border

### Appearance
font pango:JetBrainsMonoNL 12
floating_modifier $mod normal
default_border pixel 1
default_floating_border pixel 1
smart_borders on

# Color Schemes: <class> <border> <bg> <text> <indicator> <child_border>
client.focused          $sel_border  $sel_bg  $sel_fg  $sel_border  $sel_border
client.focused_inactive $norm_border $norm_bg $norm_fg $norm_border $norm_border
client.unfocused        $norm_border $norm_bg $norm_fg $norm_border $norm_border
client.urgent           #eb4d4b      #eb4d4b #ffffff  #eb4d4b      #eb4d4b

### Output Configuration
output * mode --res 1920x1080@120Hz 

### Keybindings
# Basics
bindsym $mod+Return exec $term
bindsym $mod+q kill
bindsym $mod+d exec $menu
bindsym $mod+s exec flameshot gui

# Navigation (Focus)
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+h focus left
bindsym $mod+l focus right

# Moving Windows
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+h move left
bindsym $mod+Shift+l move right

# Layout Management
bindsym $mod+b bar mode toggle
bindsym $mod+t layout tiling
bindsym $mod+m layout tabbed
bindsym $mod+f fullscreen toggle
bindsym $mod+space layout toggle split
bindsym $mod+Shift+space floating toggle

# Warpd keys
bindsym $mod+a exec warpd --hint
bindsym $mod+c exec warpd --normal

# Audio / Brightness (Function keys)
bindsym XF86AudioRaiseVolume exec ./volume_control.sh increase
bindsym XF86AudioLowerVolume exec ./volume_control.sh decrease
bindsym XF86AudioMute        exec ./volume_control.sh mute

# Brightness (Using your MODKEY + Volume combo from DWM)
bindsym $mod+XF86AudioRaiseVolume exec brightnessctl set +5%
bindsym $mod+XF86AudioLowerVolume exec brightnessctl set 5%-

# Workspace Switching
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9
bindsym $mod+Tab workspace back_and_forth

# Move container to workspace
bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6
bindsym $mod+Shift+7 move container to workspace number 7
bindsym $mod+Shift+8 move container to workspace number 8
bindsym $mod+Shift+9 move container to workspace number 9

# Exit Sway
bindsym $mod+Shift+q exec swaynag -t warning -m 'Exit Sway?' -b 'Yes' 'swaymsg exit'

### Window Rules
for_window [class="Gimp"] floating enable
for_window [class="nsxiv"] floating enable
assign [class="Firefox"] workspace number 9

### Bar Configuration
bar {
    position top
    status_command while dwmblocks; do sleep 1; done
    colors {
        statusline $norm_fg
        background $norm_bg
        focused_workspace  $sel_border $sel_bg $sel_fg
        active_workspace   $norm_border $norm_bg $norm_fg
        inactive_workspace $norm_border $norm_bg $norm_fg
        urgent_workspace   #eb4d4b #eb4d4b #ffffff
    }
}
